{
  "name": "@unclaimedsol/spl-burn-close-sdk",
  "version": "1.3.0",
  "description": "Build unsigned Solana transactions to burn SPL tokens, close token accounts, and reclaim rent with the Unclaimed SOL program.",
  "license": "MIT",
  "author": "Unclaimed SOL",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unclaimed-sol/spl-burn-close-sdk"
  },
  "bugs": {
    "url": "https://github.com/unclaimed-sol/spl-burn-close-sdk/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ./scripts/build-cjs.js",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.js",
    "test:package": "node scripts/test-package.js"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "spl-token",
    "sdk",
    "token-account",
    "close-account",
    "burn",
    "close"
  ]
}
